{
  "name": "guided-pr-review",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "pr-guide": "scripts/pr-guide.js"
  },
  "scripts": {
    "dev": "vite dev --host localhost --port 8765",
    "build:app": "vite build",
    "start": "HOST=\"${HOST:-localhost}\" PORT=\"${PORT:-8765}\" node build",
    "test": "tsx --test $(find src/lib/shared src/lib/server -name '*.test.ts') && node --test scripts/link-skill.test.js scripts/pr-guide.test.js",
    "test:svelte": "vitest run && vitest run --config vitest.ssr.config.ts",
    "check:architecture": "tsx --test scripts/check-architecture.test.ts",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.svelte.json"
  },
  "dependencies": {
    "guided-pr-review-install": "file:./scripts/install-hook",
    "@lucide/svelte": "^1.48.0",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.65.1",
    "shiki": "^3.12.2",
    "svelte": "^5.56.3",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^22.18.1",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.4.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
