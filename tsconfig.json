{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "types": ["node"]
  },
  "include": ["src/**/*", "astro.config.mjs", "scripts/**/*.ts"],
  "exclude": ["src/routes", "src/app.d.ts", "scripts/architecture-fixtures"]
}
