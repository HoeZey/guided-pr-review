{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "types": ["node"]
  },
  "include": ["src/**/*", "scripts/**/*.ts", "vite.config.ts"],
  "exclude": [
    "src/routes",
    "src/app.d.ts",
    "src/lib/client",
    "scripts/architecture-fixtures"
  ]
}
