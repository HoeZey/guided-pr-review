---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Guided review</title>
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("guided-pr-review-theme") || "light";
    </script>
  </head>
  <body>
    <div id="app">
      <p class="boot">Loading…</p>
    </div>
    <script>
      import { boot } from "../viewer.ts";
      boot();
    </script>
  </body>
</html>
